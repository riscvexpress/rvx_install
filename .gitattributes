* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - never apply eol/text conversion (avoids corruption on windows checkout)
*.so      binary
*.so.*    binary
*.pyd     binary
*.dll     binary
*.dylib   binary
*.exe     binary
*.bin     binary
*.zip     binary
*.hmac    binary
*.pem     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
