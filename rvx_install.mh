###########
# install #
###########

# pip for ./rvx_install/install.py
INSTALLER_PIP_LIST=

install_pip:
	@${PIP3_CMD} --version || ${PYTHON3_CMD} -m ensurepip --upgrade
	-@${PIP3_CMD} install -q --upgrade pip
ifneq (${INSTALLER_PIP_LIST},)
	${PIP3_CMD} install --upgrade ${INSTALLER_PIP_LIST}
endif

.PHONY: install_pip

PYTHON_CMD_LIST = cmd_list install_others install_pip_package path setup_all setup_misc setup_gitignore setup_modules setup_udev update_version_info check_install check_env check_make

${PYTHON_CMD_LIST}:%:
	@${PYTHON3_CMD} ./rvx_install/install.py -cmd $(*)

.PHONY: ${PYTHON_CMD_LIST}

#######
# all #
#######

install: install_pip install_others path setup_all

.PHONY: install

#########
# clean #
#########

CLEAN_FILE_LIST = rvx_config_path.mh rvx_config_python.mh rvx_setup.sh .rvx_path_config

clean:
	@${PYTHON3_CMD} -c "import glob, os; [(print('removed', x), os.remove(x)) for x in '${CLEAN_FILE_LIST}'.split() + glob.glob('rvx_*.log') if os.path.isfile(x)]"

.PHONY: clean
